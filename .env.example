# A private Monad mainnet RPC is recommended for production. The public RPC is
# suitable only for experimentation and read-only work.
RPC_URL=https://testnet-rpc.monad.xyz
# Private testnet alternative: https://monad-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Mainnet: https://rpc.monad.xyz (also select --network mainnet)

# Dedicated EOA only. prepare-portfolio can create an IMP or CMP for it.
PRIVATE_KEY=

# Pyth Hermes key. Keep server-side; never expose it in browser code.
PYTH_API_KEY=
